{
  "extends": ["next/core-web-vitals"],
  "plugins": ["react-hooks", "react-hooks-extra"],
  "rules": {
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "warn",
    "react-hooks-extra/no-set-state-in-use-effect": "error",
    "react-hooks-extra/purity": "warn",
    "react-hooks-extra/static-components": "warn"
  }
}
